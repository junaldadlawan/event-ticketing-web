# Copy this file to .env.development (npm run dev) and .env.production (npm run build); those are not committed.

# Where the Vite dev server proxies /api requests (the Spring Boot API).
VITE_API_TARGET=http://localhost:8081

# Stripe publishable key (pk_test_... for testing). Only the PUBLISHABLE key goes here, never a secret key (sk_...).
# Leave it empty to keep the demo "payment method token" field at checkout.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51UQMPuDoFhF7zry30U5SQOrkFmee8sNnA6HWCidfi4BYKKIP03EnvL0OLjaf7GchLjQuED06I76Tux7FBtFX77Yx00YOjILU1W

# Optional overrides for "Contact us" details (defaults in src/config.ts;
# set to an empty value to hide).
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_PHONE=
