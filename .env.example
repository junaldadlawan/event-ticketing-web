# Copy this file to .env.development (npm run dev) and .env.production (npm run build); those are not committed.

# Where the Vite dev server proxies /api requests (the Spring Boot API). Development only.
VITE_API_TARGET=http://localhost:8081

# Where a production build calls the API: its public HTTPS address, no trailing slash (for example https://api.example.com).
# Leave it empty in development (the proxy above is used). On Netlify set it in Site settings > Environment variables.
# The API must allow this site's origin in its CORS settings (app.cors.allowed-origins).
# VITE_API_BASE_URL=

# Stripe publishable key (pk_test_... for testing). Only the PUBLISHABLE key goes here, never a secret key (sk_...).
# Leave it empty to keep the demo "payment method token" field at checkout.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional overrides for "Contact us" details (defaults in src/config.ts;
# set to an empty value to hide).
# VITE_CONTACT_EMAIL=
# VITE_CONTACT_PHONE=

# PayMongo PUBLIC key (pk_test_... while testing). Set it when the API runs with PAYMENTS_GATEWAY=paymongo: the card is
# then sent straight to PayMongo. Never put a secret key (sk_...) here. Leave empty to use the demo/Stripe checkout.
VITE_PAYMONGO_PUBLIC_KEY=

# Show the "Test users" shortcut (demo accounts and their passwords) in the log in window of a BUILT site. Always on in
# development. Only for a demo or staging site: set it to true in Netlify; leave it out for a real one.
# VITE_SHOW_TEST_USERS=true
